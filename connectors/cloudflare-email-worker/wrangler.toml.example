name = "paygate-email-ingress"
main = "worker.js"
compatibility_date = "2026-08-12"

[vars]
PAYGATE_EMAIL_WEBHOOK_URL = "https://payments.example.org/api/events/email"
PAYGATE_EMAIL_RECIPIENT = "payments@example.org"
PAYGATE_EMAIL_FALLBACK_RECIPIENT = "payment-failures@example.net"

# Add PAYGATE_EMAIL_WEBHOOK_SECRET with:
#   npx wrangler secret put PAYGATE_EMAIL_WEBHOOK_SECRET
