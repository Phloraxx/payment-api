# syntax=docker/dockerfile:1.7

FROM node:22.23.1-bookworm-slim AS web-build
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci
COPY web-v4 ./web-v4
RUN npm run typecheck:v4 && npm run build:v4

FROM golang:1.25.13-bookworm AS go-build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY --from=web-build /src/internal/v4web/dist ./internal/v4web/dist
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/paygate-v4 ./cmd/paygate-v4
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/paygate-v4-migrate ./cmd/paygate-v4-migrate
RUN mkdir -p /out/data /out/backups

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=go-build --chown=nonroot:nonroot /out/paygate-v4 /app/paygate-v4
COPY --from=go-build --chown=nonroot:nonroot /out/paygate-v4-migrate /app/paygate-v4-migrate
COPY --from=go-build --chown=nonroot:nonroot /out/data /app/data
COPY --from=go-build --chown=nonroot:nonroot /out/backups /app/backups
COPY --chown=nonroot:nonroot LICENSE NOTICE /app/
ENV PAYGATE_V4_DATA_DIR=/app/data \
    PAYGATE_V4_BACKUP_DIR=/app/backups \
    PAYGATE_V4_LISTEN_ADDR=0.0.0.0:8091
USER nonroot:nonroot
EXPOSE 8091
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD ["/app/paygate-v4", "healthcheck"]
ENTRYPOINT ["/app/paygate-v4"]
