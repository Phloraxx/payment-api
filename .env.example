# PayGate v4 server
PAYGATE_V4_DATA_DIR=./data
PAYGATE_V4_BACKUP_DIR=./backups
PAYGATE_V4_LISTEN_ADDR=:8091
PAYGATE_V4_PUBLIC_URL=https://pay.example.com
PAYGATE_V4_ALLOWED_ORIGINS=https://pay.example.com

# Required only when bootstrapping a fresh database.
# Remove these from the runtime environment after the initial bootstrap.
PAYGATE_V4_ADMIN_PASSWORD=replace-with-a-strong-admin-password
PAYGATE_V4_MERCHANT_API_KEY=replace-with-a-long-random-merchant-key

# Optional initial merchant webhook. It can also be configured later in Settings.
PAYGATE_V4_WEBHOOK_ENDPOINT=https://merchant.example.com/webhooks/paygate
PAYGATE_V4_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# Online SQLite backup schedule.
PAYGATE_V4_BACKUP_HOUR_UTC=3
PAYGATE_V4_BACKUP_RETENTION=30

# paygate-v4-migrate only; not required by the normal server.
PAYGATE_V4_ACTIVE_PROFILE=kotak
PAYGATE_V4_KOTAK_UPI_ID=merchant@bank
PAYGATE_V4_KOTAK_PAYEE=Merchant Name
PAYGATE_V4_PAYTM_UPI_ID=merchant@paytm
PAYGATE_V4_PAYTM_PAYEE=Merchant Name
