# Required in normal serve mode. UPI_ID remains a backward-compatible alias
# for KOTAK_UPI_ID, but new deployments should configure each bank explicitly.
KOTAK_UPI_ID=operator@kotak
KOTAK_UPI_PAYEE_NAME=PayGate Operator
SLICE_UPI_ID=operator@slice
SLICE_UPI_PAYEE_NAME=PayGate Operator
# Optional Paytm for Business rail. PAYTM_UPI_ID enables exact-amount QR-only
# checkout verified by the signed PayGate Relay Android notification connector.
PAYTM_UPI_ID=
PAYTM_PAYEE_NAME=Paytm for Business
# Legacy MacroDroid/static-QR compatibility only; leave empty on new deployments.
PAYTM_QR_PAYLOAD=
PAYTM_NOTIFICATION_WEBHOOK_SECRET=
# Temporary enrollment secret for PayGate Relay Android devices. Remove it after pairing.
ANDROID_RELAY_ENROLLMENT_ENABLED=false
ANDROID_RELAY_PAIRING_SECRET=
# Paytm checkout creation fails closed if no enabled relay device has validated
# activity/heartbeat within this window. WorkManager heartbeat safety runs every 15m.
ANDROID_RELAY_STALE_AFTER=1h
PAYMENT_DEFAULT_ACCOUNT=kotak
# UPI_ID=
# UPI_PAYEE_NAME=
PAYGATE_API_KEY=replace-with-at-least-24-random-characters
SMS_WEBHOOK_SECRET=replace-with-a-different-at-least-24-character-secret

# Persistence / external URL
PB_DATA_DIR=/app/pb_data

# DDM lifecycle
PAYMENT_TTL=5m
PAYMENT_QUARANTINE=24h

# PocketBase request rate limits
PAYGATE_RATE_LIMITS_ENABLED=true

# Optional Google Messages connector
GMESSAGES_ENABLED=false
# GMESSAGES_SESSION_PATH=/app/pb_data/gmessages/session.json

# Optional bank payment-email evidence via the Cloudflare Email Routing Worker
# in connectors/cloudflare-email-worker. Keep disabled until a real redacted
# bank message fixture has passed parser and authentication acceptance tests.
PAYMENT_EMAIL_ENABLED=false
PAYMENT_EMAIL_WEBHOOK_SECRET=
PAYMENT_EMAIL_ALLOWED_SENDER=noreply@slice.bank.in
PAYMENT_EMAIL_AUTH_SERV_ID=mx.cloudflare.net
PAYMENT_EMAIL_SIGNATURE_TOLERANCE=5m

# Optional signed outgoing payment webhooks
OUTGOING_WEBHOOK_URL=
OUTGOING_WEBHOOK_SECRET=

# Migration-only compatibility for the old Android relay at POST /api/webhook.
# Leave disabled for new deployments. When enabled, WEBHOOK_SECRET is required.
LEGACY_SMS_WEBHOOK_ENABLED=false
WEBHOOK_SECRET=

# Other legacy prototype aliases still understood during migration:
# UPI_NAME=PayGate Operator
# TICKET_TTL_MINUTES=5
# AMOUNT_QUARANTINE_HOURS=24
# PAYMENT_WEBHOOK_URL=
# PAYMENT_WEBHOOK_SECRET=

# Tests only; do not enable in production.
PAYGATE_TEST_MODE=false

# Bank statement timestamps without an explicit offset are interpreted in this timezone.
STATEMENT_TIMEZONE=Asia/Kolkata

# Evidence privacy retention (Go duration syntax; 24h = 1 day)
PAYGATE_RETENTION_ENABLED=true
SMS_RAW_RETENTION=2160h
EMAIL_RAW_RETENTION=2160h
PAYTM_NOTIFICATION_RAW_RETENTION=720h
RELAY_RAW_RETENTION=720h
RECONCILIATION_RAW_RETENTION=8760h
AUDIT_RETENTION=17520h

# Scheduled PocketBase backups. Empty cron disables automatic backups.
# The default runs daily at 03:00 in the server timezone and keeps 14 archives.
PAYGATE_BACKUP_CRON="0 3 * * *"
PAYGATE_BACKUP_MAX_KEEP=14

# Optional S3-compatible off-server backup storage.
PAYGATE_BACKUP_S3_ENABLED=false
PAYGATE_BACKUP_S3_BUCKET=
PAYGATE_BACKUP_S3_REGION=
PAYGATE_BACKUP_S3_ENDPOINT=
PAYGATE_BACKUP_S3_ACCESS_KEY=
PAYGATE_BACKUP_S3_SECRET=
PAYGATE_BACKUP_S3_FORCE_PATH_STYLE=false

# Optional signed operator-alert webhook for connector, capacity, webhook,
# reconciliation and backup failures. Both values are required together.
OPERATOR_ALERT_WEBHOOK_URL=
OPERATOR_ALERT_WEBHOOK_SECRET=

# Optional isolated Razorpay Test Mode rail. Keep disabled in production.
RAZORPAY_TEST_ENABLED=false
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_WEBHOOK_SECRET=
RAZORPAY_TEST_DISPLAY_NAME=PayGate Razorpay Test


# Optional isolated Razorpay Live pilot. Initially hard-capped to exactly ₹1.
RAZORPAY_LIVE_ENABLED=false
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_LIVE_WEBHOOK_SECRET=
RAZORPAY_LIVE_DISPLAY_NAME=IEEE Sahrdaya Razorpay Live
